# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — enables richer keyword data, competitor gap analysis, backlink intelligence
DATAFORSEO_LOGIN=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_password

# Optional — live Google SERP rank checking
SERPAPI_KEY=your_serpapi_key_here

# Optional — Google Search Console real traffic data
# Path to a GCP service account JSON key with Search Console read access
# Setup: GCP Console → Service Accounts → create key → download JSON → set path here
GSC_SERVICE_ACCOUNT_JSON=/path/to/your/gsc-service-account.json
