# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — enables richer keyword + SERP data
DATAFORSEO_LOGIN=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_password

# Optional — alternative SERP data source
SERPAPI_KEY=your_serpapi_key_here

# Facebook Auto-Share
# Long-lived user access token from developers.facebook.com
# Requires publish_to_groups + groups_access_member_info permissions
FACEBOOK_ACCESS_TOKEN=your_long_lived_user_access_token
# Comma-separated list of Facebook Group IDs to post to
FACEBOOK_GROUP_IDS=group_id_1,group_id_2,group_id_3
# Graph API version (default: v21.0)
FACEBOOK_GRAPH_VERSION=v21.0
